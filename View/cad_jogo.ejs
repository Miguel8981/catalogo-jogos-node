<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= jogo.id > 0 ? "Editar jogo" : "Cadastrar jogo" %></title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/cad_jogo.css">
</head>
<body>
    <%- include("topo") %>

    <main>
        <section class="cartao">
            <h2><%= jogo.id > 0 ? "Editar jogo" : "Cadastrar jogo" %></h2>

            <% if (erro !== "") { %>
                <p class="aviso erro"><%= erro %></p>
            <% } %>

            <form method="post" action="/jogos/salvar">
                <input type="hidden" name="id" value="<%= jogo.id %>">

                <label>Nome do jogo
                    <input type="text" name="nome" maxlength="100" required value="<%= jogo.nome %>">
                </label>

                <label>Plataforma
                    <input type="text" name="plataforma" maxlength="50" placeholder="PC, PlayStation, Xbox..." required value="<%= jogo.plataforma %>">
                </label>

                <label>Gênero
                    <select name="id_genero" required>
                        <option value="">Selecione</option>
                        <% generos.forEach((genero) => { %>
                            <option value="<%= genero.id %>" <%= genero.id == jogo.id_genero ? "selected" : "" %>>
                                <%= genero.nome %>
                            </option>
                        <% }) %>
                    </select>
                </label>

                <section class="linha">
                    <label>Ano de lançamento
                        <input type="number" name="ano_lancamento" min="1950" max="2100" required value="<%= jogo.ano_lancamento %>">
                    </label>

                    <label>Nota (0 a 10)
                        <input type="number" name="nota" min="0" max="10" step="0.1" required value="<%= jogo.nota %>">
                    </label>
                </section>

                <label>Status
                    <select name="status">
                        <% statusLista.forEach((s) => { %>
                            <option value="<%= s %>" <%= s == jogo.status ? "selected" : "" %>>
                                <%= s %>
                            </option>
                        <% }) %>
                    </select>
                </label>

                <section class="linha">
                    <button type="submit"><%= jogo.id > 0 ? "Salvar alterações" : "Cadastrar" %></button>
                    <a class="botao-cancelar" href="/jogos">Cancelar</a>
                </section>
            </form>
        </section>
    </main>

    <%- include("rodape") %>
</body>
</html>

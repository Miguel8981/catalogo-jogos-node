<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minha biblioteca de jogos</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/visu_jogos.css">
</head>
<body>
    <%- include("topo") %>

    <main>
        <section class="cartao">
            <h2>Minha biblioteca</h2>

            <% if (msg !== "") { %>
                <p class="aviso sucesso"><%= msg %></p>
            <% } %>

            <form class="filtro" method="get" action="/jogos">
                <label>Filtrar por gênero
                    <select name="genero">
                        <option value="0">Todos</option>
                        <% generos.forEach((genero) => { %>
                            <option value="<%= genero.id %>" <%= genero.id == idGenero ? "selected" : "" %>>
                                <%= genero.nome %>
                            </option>
                        <% }) %>
                    </select>
                </label>
                <button type="submit">Filtrar</button>
                <a class="botao-limpar" href="/jogos">Limpar</a>
            </form>

            <% if (jogos.length === 0) { %>
                <p>Nenhum jogo encontrado.</p>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Gênero</th>
                            <th>Plataforma</th>
                            <th>Ano</th>
                            <th>Nota</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% jogos.forEach((jogo) => { %>
                            <tr>
                                <td><%= jogo.nome %></td>
                                <td><%= jogo.genero %></td>
                                <td><%= jogo.plataforma %></td>
                                <td><%= jogo.ano_lancamento %></td>
                                <td><%= jogo.nota %></td>
                                <td><%= jogo.status %></td>
                                <td class="acoes">
                                    <a class="botao-editar" href="/jogos/<%= jogo.id %>/editar">Editar</a>
                                    <form method="post" action="/jogos/<%= jogo.id %>/excluir"
                                          onsubmit="return confirm('Excluir este jogo?');">
                                        <button type="submit" class="botao-excluir">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </section>
    </main>

    <%- include("rodape") %>
</body>
</html>
